# Chem-ElectroLabs - Variabel Lingkungan Mode Guru
# ==============================================================================
# VITE_TEACHER_CODE_HASH: Hash SHA-256 (huruf kecil, heksadesimal 64 karakter) dari kode akses guru.
# Kode asli TIDAK BOLEH dituliskan di source code demi perlindungan keamanan.
#
# CARA MEMBUAT HASH SHA-256 DARI KODE ANDA SENDIRI:
# ------------------------------------------------------------------------------
# Cara 1: Menggunakan PowerShell (Windows):
#   [BitConverter]::ToString([System.Security.Cryptography.SHA256]::Create().ComputeHash([System.Text.Encoding]::UTF8.GetBytes("KODE_ANDA"))).Replace("-","").ToLower()
#
# Cara 2: Menggunakan Node.js (Semua OS):
#   node -e "crypto.subtle.digest('SHA-256', new TextEncoder().encode('KODE_ANDA')).then(b => console.log(Array.from(new Uint8Array(b)).map(x=>x.toString(16).padStart(2,'0')).join('')))"
#
# Cara 3: Menggunakan Console Browser (F12):
#   crypto.subtle.digest('SHA-256', new TextEncoder().encode('KODE_ANDA')).then(b => console.log(Array.from(new Uint8Array(b)).map(x=>x.toString(16).padStart(2,'0')).join('')))
# ==============================================================================

# Contoh hash di bawah adalah hasil SHA-256 dari kode default pengujian: "KIMIA2026"
VITE_TEACHER_CODE_HASH=9af4a2620dd33a3735a2474f6dcf372bb6a4912988f28b4cc3c2c0cc61fb1181

